---
import portfolio from "../generated/portfolio.json";
const { settings, arUI: ui } = portfolio;
---
<div class="contactModal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="contactTitle" aria-hidden="true">
  <button class="contactBackdrop" type="button" aria-label={ui.closeContact} data-i18n-aria-label="closeContact" data-contact-close>
</button>
  <div class="contactSheet" tabindex="-1">
    <div class="contactGlow" aria-hidden="true">
</div>
    <div class="contactTop">
<span class="eyebrow" data-t="contactEyebrow" set:html={ui.contactEyebrow}>
</span>
<button class="contactX" type="button" data-contact-close aria-label={ui.close} data-i18n-aria-label="close">×</button>
</div>
    <h2 id="contactTitle" data-t="contactTitle" set:html={ui.contactTitle}>
</h2>
    <p class="contactLead" data-t="contactDesc" set:html={ui.contactDesc}>
</p>
    <div class="contactChoices">
      <a class="contactChoice" id="callLink" href={settings.contactE164 && `tel:${settings.contactE164}` || undefined} aria-label={ui.callAction} data-i18n-aria-label="callAction">
<span class="contactChoiceIcon" aria-hidden="true">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
<path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.09 5.18 2 2 0 0 1 5.08 3h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.67 2.8a2 2 0 0 1-.45 2.11L9 10.91a16 16 0 0 0 4.09 4.09l1.28-1.3a2 2 0 0 1 2.11-.45c.9.32 1.84.55 2.8.67A2 2 0 0 1 22 16.92z"/>
</svg>
</span>
<span class="contactChoiceCopy">
<strong data-t="contactCall" set:html={ui.contactCall}>
</strong>
<small data-t="contactCallSub" set:html={ui.contactCallSub}>
</small>
</span>
<span class="contactChoiceArrow" aria-hidden="true">↗</span>
</a>
      <a class="contactChoice" id="waLink" href={settings.contactE164 && `https://wa.me/${settings.contactE164.slice(1)}` || undefined} target="_blank" rel="noopener noreferrer" aria-label={ui.waAction} data-i18n-aria-label="waAction">
<span class="contactChoiceIcon" aria-hidden="true">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
<path d="M21.2 11.65A9.16 9.16 0 0 1 7.6 19.62L3 21l1.45-4.43A9.16 9.16 0 1 1 21.2 11.65z"/>
<path d="M8.55 8.1c-.31.26-.77 1.03-.58 1.75.32 1.29 2.54 3.58 4.07 4.4.8.44 1.52.35 2.12-.15l.8-.8-2-1.03-.97.96c-1.25-.55-2.17-1.49-2.7-2.65l.82-.83z"/>
</svg>
</span>
<span class="contactChoiceCopy">
<strong data-t="contactWhats" set:html={ui.contactWhats}>
</strong>
<small data-t="contactWhatsSub" set:html={ui.contactWhatsSub}>
</small>
</span>
<span class="contactChoiceArrow" aria-hidden="true">↗</span>
</a>
    </div>
    <div class="contactSignature">ALI ABUWARDEH <span>•</span> <span data-t="contactClose" set:html={ui.contactClose}>
</span>
</div>
  </div>
</div>

<div id="projectModal" class="modal" role="dialog" aria-modal="true" aria-label={ui.projectDetails} data-i18n-aria-label="projectDetails">
<div class="modalPanel">
<button class="close" id="closeProject" aria-label={ui.close} data-i18n-aria-label="close">×</button>
<div id="projectDetails">
</div>
</div>
</div>
<div id="videoModal" class="modal" role="dialog" aria-modal="true" aria-label={ui.videoPreview} data-i18n-aria-label="videoPreview">
<div class="videoModalContent">
<button class="close" id="closeVideo" aria-label={ui.close} data-i18n-aria-label="close">×</button>
<div class="eyebrow" data-t="videoEyebrow" set:html={ui.videoEyebrow}>
</div>
<h2 id="videoModalTitle">
</h2>
<p id="videoModalDesc">
</p>
<video id="videoPlayer" controls playsinline>
</video>
<p id="videoPlaceholder" class="softcap">
</p>
<label>
<span data-t="videoLoad" set:html={ui.videoLoad}>
</span>
<input id="videoFile" type="file" accept="video/*">
</label>
</div>
</div>
