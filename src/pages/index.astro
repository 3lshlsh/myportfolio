---
import portfolio from "../generated/portfolio.json";
const { arUI: ui } = portfolio;
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Journey from "../components/Journey.astro";
import Archive from "../components/Archive.astro";
import Projects from "../components/Projects.astro";
import Packaging from "../components/Packaging.astro";
import Films from "../components/Films.astro";
import Models from "../components/Models.astro";
import Footer from "../components/Footer.astro";
import Dialogs from "../components/Dialogs.astro";
import "../styles/portfolio.css";
---
<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{ui.pageTitle}</title><meta name="description" content={ui.description}><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head><body>
<Header />
<Hero />
<Journey />
<Archive />
<Projects />
<Packaging />
<Films />
<Models />
<Footer />
<Dialogs />
<script>import "../scripts/site.js";</script>
</body></html>
